 # --- Run mkdocs ------------------------------------------------------------
 echo "[rtd-build] Building docs (DOCS_LANG=$DOCS_LANG, DOCS_IS_RELEASE=$DOCS_IS_RELEASE, site_dir=$SITE_DIR)..."
+# 离线打包去掉 --strict：上游文档常出现 nav 引用已删页面、跨页锚点失效等 warning，
+# strict 会让整站构建因一条 warning 中止，而离线产物并不需要这道质量门禁。
