diff --git a/docs/.overrides/partials/source.html b/docs/.overrides/partials/source.html
new file mode 100644
index 0000000000..0d1a76433a
--- /dev/null
+++ b/docs/.overrides/partials/source.html
@@ -0,0 +1,16 @@
+{#
+  离线覆盖：Material 的 source 组件带 data-md-component="source" 时，
+  bundle.js 会去请求 https://api.github.com/repos/<org>/<repo>/releases/latest
+  和 /repos/<org>/<repo> 取 star / release 数——断网时这些请求要等 DNS 超时。
+  这里保留同样的 DOM 和图标，只去掉 data-md-component，于是它退化成普通超链接。
+#}
+{% if config.repo_url %}
+<a href="{{ config.repo_url }}" title="{{ lang.t('source') }}" class="md-source">
+  <div class="md-source__icon md-icon">
+    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512"><path fill="currentColor" d="M439.6 236.1 244 40.5c-5.4-5.5-12.8-8.5-20.4-8.5s-15 3-20.4 8.4L162.5 81l51.5 51.5c27.1-9.1 52.7 16.8 43.4 43.7l49.7 49.7c34.2-11.8 61.2 31 35.5 56.7-26.5 26.5-70.2-2.9-56-37.3L240.3 199v121.9c25.3 12.5 22.3 41.8 9.1 55-6.4 6.4-15.2 10.1-24.3 10.1s-17.8-3.6-24.3-10.1c-17.6-17.6-11.1-46.9 11.2-56v-123c-20.8-8.5-24.6-30.7-18.6-45L142.6 101 8.5 235.1C3 240.6 0 247.9 0 255.5s3 15 8.5 20.4l195.6 195.7c5.4 5.4 12.7 8.4 20.4 8.4s15-3 20.4-8.4l194.7-194.7c5.4-5.4 8.4-12.8 8.4-20.4s-3-15-8.4-20.4"/></svg>
+  </div>
+  <div class="md-source__repository">
+    {{ config.repo_name }}
+  </div>
+</a>
+{% endif %}
