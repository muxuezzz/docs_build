--- a/docs/mkdocs/javascript/mathjax.js
+++ b/docs/mkdocs/javascript/mathjax.js
@@ -14,6 +14,21 @@ window.MathJax = {
 
 let mathJaxLoading;
 
+// 离线构建：MathJax 由构建脚本下载到 javascript/vendor/ 并随站点打包，不再从 unpkg 拉取。
+// 脚本解析时（document.currentScript 有效）记下自身所在目录——放到回调里再读会拿到 null，
+// 那时相对路径会按页面层级解析，子目录页面就 404 了。
+const MATHJAX_BASE = (function () {
+  const self = document.currentScript && document.currentScript.src;
+  return self ? self.replace(/[^/]*$/, "") : null;
+})();
+
+function mathJaxVendorUrl() {
+  if (MATHJAX_BASE) {
+    return MATHJAX_BASE + "vendor/mathjax/tex-mml-chtml.js";
+  }
+  return "javascript/vendor/mathjax/tex-mml-chtml.js";
+}
+
 function loadMathJax() {
   if (window.MathJax.typesetPromise) {
     return Promise.resolve();
@@ -21,7 +36,7 @@ function loadMathJax() {
