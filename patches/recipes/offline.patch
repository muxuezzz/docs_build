+{#
+  离线覆盖：Material 的 source 组件带 data-md-component="source" 时，
+  bundle.js 会去请求 https://api.github.com/repos/<org>/<repo>/releases/latest
+  和 /repos/<org>/<repo> 拿 star/fork 数 —— 断网时这些请求会挂起。
+  这里保留同样的 DOM 结构和图标，只去掉 data-md-component，
+  于是只剩一个普通超链接，不再发任何请求。
+#}
+{% if config.repo_url %}
+<a href="{{ config.repo_url }}" title="{{ lang.t('source') }}" class="md-source">
